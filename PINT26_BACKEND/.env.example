# ==========================================
# SoftBadge Backend - Environment Variables
# ==========================================

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Base de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=softbadge
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Autenticação JWT
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Configuração SMTP (Envio de Emails / Notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_de_aplicativo
SMTP_FROM="SoftBadge <noreply@softbadge.pt>"

# URL Pública / CORS
CLIENT_URL=http://localhost:3001
LANDING_URL=http://localhost:3002
API_BASE_URL=http://localhost:3000

